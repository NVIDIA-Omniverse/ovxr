#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Y"
    subLayers = [@xr-room.usda@]
)

# Reusable geometry; each hand primitive receives a scene-space transform.
class Sphere "HandJoint" (prepend apiSchemas = ["MaterialBindingAPI"])
{
    double radius = 0.0095
    double3 xformOp:translate = (0, -100, 0)
    uniform token[] xformOpOrder = ["xformOp:translate"]
    rel material:binding = </World/Materials/HandMint>
}
class Cylinder "HandBone" (prepend apiSchemas = ["MaterialBindingAPI"])
{
    double radius = 1
    double height = 1
    uniform token axis = "Z"
    double3 xformOp:translate = (0, -100, 0)
    uniform token[] xformOpOrder = ["xformOp:translate"]
    rel material:binding = </World/Materials/HandMint>
}
class Sphere "HandPalm" (prepend apiSchemas = ["MaterialBindingAPI"])
{
    double radius = 1
    double3 xformOp:translate = (0, -100, 0)
    uniform token[] xformOpOrder = ["xformOp:translate"]
    rel material:binding = </World/Materials/HandMint>
}

# World-space panel geometry participates in scene depth and ray hit testing.
over "World"
{
    def Scope "Materials"
    {
        def Material "HandMint"
        {
            token outputs:mdl:surface.connect = </World/Materials/HandMint/Shader.outputs:out>
            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @OmniPBR.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
                color3f inputs:diffuse_color_constant = (0.02, 0.38, 0.12)
                float inputs:reflection_roughness_constant = 0.7
                token outputs:out
            }
        }
        def Material "OccluderViolet"
        {
            token outputs:mdl:surface.connect = </World/Materials/OccluderViolet/Shader.outputs:out>
            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @OmniPBR.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
                color3f inputs:diffuse_color_constant = (0.13, 0.025, 0.32)
                float inputs:reflection_roughness_constant = 0.7
                token outputs:out
            }
        }
        def Material "PanelIvory"
        {
            token outputs:mdl:surface.connect = </World/Materials/PanelIvory/Shader.outputs:out>
            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @OmniPBR.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
                color3f inputs:diffuse_color_constant = (0.6, 0.5, 0.35)
                float inputs:reflection_roughness_constant = 0.8
                token outputs:out
            }
        }
    }
    def Cube "Panel" (prepend apiSchemas = ["MaterialBindingAPI"])
    {
        double size = 1
        double3 xformOp:translate = (0, 0.9, 0.96)
        double3 xformOp:scale = (2.4, 0.65, 0.04)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        rel material:binding = </World/Materials/PanelIvory>
    }
    def Cube "Button1" (prepend apiSchemas = ["MaterialBindingAPI"])
    {
        double size = 1
        double3 xformOp:translate = (-0.9, 0.9, 1.04)
        double3 xformOp:scale = (0.45, 0.35, 0.08)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        rel material:binding = </World/Materials/Blue>

#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Y"
)

# Empty background rays plus lit opaque objects: black is not transparency.
# OVXR authors AR compositing settings on its runtime RenderProducts.
def Xform "World"
{
    def Xform "StartAnchor"
    {
        double3 xformOp:translate = (0, 0, 3)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }
    def Sphere "ColoredObject" (prepend apiSchemas = ["MaterialBindingAPI"])
    {
        double radius = 0.45
        double3 xformOp:translate = (-0.6, 1.5, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        rel material:binding = </World/Materials/Amber>
    }
    def Cube "DarkObject" (prepend apiSchemas = ["MaterialBindingAPI"])
    {
        double size = 0.75
        double3 xformOp:translate = (0.6, 1.5, 0)
        float3 xformOp:rotateXYZ = (0, 25, 0)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateXYZ"]
        rel material:binding = </World/Materials/Dark>
    }
    def DomeLight "Sky"
    {
        float inputs:intensity = 800
        bool visibleInPrimaryRay = false
    }
    def Scope "Materials"
    {
        def Material "Amber"
        {
            token outputs:mdl:surface.connect = </World/Materials/Amber/Shader.outputs:out>
            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @OmniPBR.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
                color3f inputs:diffuse_color_constant = (0.85, 0.28, 0.025)
                float inputs:reflection_roughness_constant = 0.75
                token outputs:out
            }
        }
        def Material "Dark"
        {
            token outputs:mdl:surface.connect = </World/Materials/Dark/Shader.outputs:out>
            def Shader "Shader"
            {
                uniform token info:implementationSource = "sourceAsset"
                uniform asset info:mdl:sourceAsset = @OmniPBR.mdl@
                uniform token info:mdl:sourceAsset:subIdentifier = "OmniPBR"
                color3f inputs:diffuse_color_constant = (0.015, 0.02, 0.025)
                float inputs:reflection_roughness_constant = 0.85
                token outputs:out
            }
        }
    }
}
